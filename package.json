{
  "name": "idempotent-payment-instructions",
  "version": "0.1.0",
  "private": true,
  "description": "Records payment instructions in Postgres so that a retried request can never create one twice.",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
